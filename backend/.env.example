# ===========================================
# GRIT Data Engine — Backend Environment
# ===========================================
# Updated 2026-05-23 from live code audit. Replace placeholder values then
# rename to `.env` (or set as Replit Secrets) before running uvicorn.
# REPLICATE_API_KEY and FIRECRAWL_API_KEY entries from older drafts are
# intentionally removed — the running code never reads them.
# ===========================================

# ───────────────────────────────────────────
# SUPABASE (required for any DB-backed flow)
# ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Either SUPABASE_SERVICE_KEY or SUPABASE_API_KEY works — main.py bridges them.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ───────────────────────────────────────────
# AI / LLM PROVIDERS
# ───────────────────────────────────────────
# Required for Agent 2 (profile verification), Agent 3 (AI brief),
# Agent 4 (intelligence parsing), and the manual ingestion validator.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# Required for Agent 7 (DALL-E 3 fighter portraits) and any future embeddings.
OPENAI_API_KEY=sk-your_openai_key

# ───────────────────────────────────────────
# SEARCH / SCRAPING
# ───────────────────────────────────────────
# Required for Agents 1, 2, 3, 4, 7 (Brave URL discovery + image reference search).
BRAVE_API_KEY=your_brave_api_key

# ───────────────────────────────────────────
# GRIT MAIN APP INTEGRATION (outbound webhook target)
# ───────────────────────────────────────────
# Where to push clean records (fighters, events, fight history, news, odds).
# Use http://localhost:3001 for local dev against gritapp; production = Railway URL.
MAIN_APP_API_URL=http://localhost:3001

# Shared secret — must match `DATA_ENGINE_API_KEY` in gritapp's `.env`.
DATA_ENGINE_API_KEY=your_shared_secret_key_here

# ───────────────────────────────────────────
# CORS (frontend operator dashboard)
# ───────────────────────────────────────────
# Comma-separated origins allowed to call the API. Default covers local Vite dev.
# Add your production frontend URL when you deploy.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# ───────────────────────────────────────────
# NOT USED — kept here so older docs don't trip people up
# ───────────────────────────────────────────
# REPLICATE_API_KEY — referenced in older drafts only; not read by current code
# FIRECRAWL_API_KEY — same; ingestion uses Brave + direct scrapers instead
